# dependencies
/node_modules

# next.js
/.next
/out

# typescript
next-env.d.ts
*.tsbuildinfo

# cloudflare / wrangler local secrets
.dev.vars
.wrangler

# python pipeline secrets (IGDB / Twitch credentials)
.env
.env.local

# python
__pycache__/
*.pyc

# build artifact: the SQLite DB is regenerated deterministically by the
# pipeline (init_db + ingest_* + enrich + kin). Only its EXPORT
# (data/export/*.json) is committed and consumed by the Next build. Never
# commit the DB — it inflates past git's comfort once Steam data + enrichment
# land, and every regen would be a multi-MB binary diff.
data/gde.sqlite
data/gde.sqlite-journal
data/gde.sqlite-wal
data/gde.sqlite-shm

# misc
.DS_Store
*.log
npm-debug.log*
